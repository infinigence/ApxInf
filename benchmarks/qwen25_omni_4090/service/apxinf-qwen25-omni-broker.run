#!/bin/sh
set -eu

: "${APXINF_WORKDIR:?set the ApxInf source checkout}"
: "${APXINF_MODEL_DIR:?set the Qwen2.5-Omni model directory}"
: "${APXINF_BINARY:?set the compiled ApxInf binary}"
: "${APXINF_PROCESSOR_PATH:?set the pinned processor Python path}"
: "${APXINF_CACHE_ROOT:?set a writable cache directory}"

gpu_run=${APXINF_GPU_RUN:-gpu-run}

exec chpst -u gpuq:gpuq-users "$gpu_run" \
  --owner codex-apxinf --label qwen25-omni-service \
  --mode exclusive --gpu-count 1 \
  --cwd "$APXINF_WORKDIR" \
  --estimate unknown --queue-timeout 24h --run-timeout 8760h -- \
  env \
  PYTHONPATH="$APXINF_PROCESSOR_PATH" \
  HF_HOME="$APXINF_CACHE_ROOT/huggingface" \
  TRANSFORMERS_OFFLINE=1 \
  HF_HUB_OFFLINE=1 \
  TOKENIZERS_PARALLELISM=false \
  APXINF_DISABLE_TALKER=1 \
  APXINF_OMNI_PERSISTENT_PROCESSOR=1 \
  APXINF_VISION_GROUPED_SPARSE=1 \
  APXINF_VISION_GROUPED_FA2=1 \
  APXINF_VISION_FULL_FA2=1 \
  APXINF_BATCHED_GQA_PREFILL=1 \
  APXINF_FA2_GQA_PREFILL=1 \
  APXINF_QWEN25_FA2_CHUNK1024=1 \
  APXINF_QWEN25_FA2_ALL_CHUNKS=1 \
  APXINF_QWEN25_LONG_DECODE_SPLIT_CTA=1 \
  APXINF_QWEN25_LONG_DECODE_GRAPH=1 \
  APXINF_STREAM_ORDERED_ALLOC=1 \
  APXINF_TMROPE_POSITION_CACHE=1 \
  APXINF_TMROPE_POSITION_CACHE_PREFILL=1 \
  APXINF_SOFTMAX_EXP_CACHE=1 \
  APXINF_SOFTMAX_GLOBAL_EXP_CACHE=1 \
  APXINF_SOFTMAX_EXP_CACHE_LONG_FALLBACK=1 \
  APXINF_SOFTMAX_INPLACE_SCALE=1 \
  APXINF_QWEN25_DECODE_GRAPH=1 \
  APXINF_QWEN25_GPU_ARGMAX=1 \
  APXINF_QWEN25_EAGER_GPU_ARGMAX=1 \
  APXINF_QWEN25_GPU_LAST_ROW=1 \
  APXINF_QWEN25_PACKED_QKV=1 \
  APXINF_QWEN25_FUSED_TMROPE_KV=1 \
  APXINF_QWEN25_FUSED_SILU_MUL=1 \
  APXINF_QWEN25_CHUNKED_PREFILL=1 \
  APXINF_QWEN25_BF16_CHUNK_TACTICS=1 \
  APXINF_QWEN25_M1_PACKED_MLP=1 \
  APXINF_QWEN25_PREFILL_PACKED_MLP=1 \
  APXINF_QWEN25_M512_PACKED_QKV_TACTIC=1 \
  APXINF_QWEN25_M1760_GEMM_TACTICS=1 \
  APXINF_QWEN25_PREFILL_PACKED_QKV_PRELUDE=1 \
  APXINF_QWEN25_M1_GEMV_TACTICS=1 \
  APXINF_QWEN25_SHORT_DECODE_EXACT_RESIDUAL_NORM=1 \
  APXINF_QWEN25_SHORT_DECODE_W32_ATTENTION=1 \
  APXINF_QWEN25_SHORT_DECODE_FUSED_QKV_PRELUDE=1 \
  APXINF_QWEN25_SHORT_DECODE_PACK8_RESIDUAL_NORM=1 \
  APXINF_QWEN25_SCALED_EXP_CACHE_PREFILL=1 \
  APXINF_QWEN25_VISION_QKV_BIAS_ROPE=1 \
  APXINF_QWEN25_VISION_FUSED_SILU_MUL=1 \
  APXINF_QWEN25_VISION_BIAS_RESIDUAL=1 \
  APXINF_QWEN25_VISION_GATE_UP_BIAS_SILU_MUL=1 \
  APXINF_QWEN25_VISION_GROUPED_QKV_LAYOUT=1 \
  APXINF_QWEN25_VISION_PACKED_QKV=1 \
  APXINF_QWEN25_VISION_PACKED_GATE_UP=1 \
  "$APXINF_BINARY" serve \
  --model "$APXINF_MODEL_DIR" \
  --host 127.0.0.1 --port 8001 \
  --max-model-len 32768 --enable-multimodal

/target
models/
nsys/
*.nsys-rep

# Local generated artifacts
.DS_Store
__pycache__/
*.py[cod]
# Native Python extension / in-tree build products
*.so
build/
*.egg-info/

# Local model-port worktrees
experiment/

# `build_support/` is crate source, not build output. A global `**/build*/`
# exclude is common on developers' machines, and it would swallow new files
# there without a trace from `git add`. Re-include the directory so the
# higher-priority rule here wins.
!**/build_support/

# Autotune writes recipes through `<name>.recipe.<pid>.tmp` + rename; an
# interrupted tune can leave the temporary behind.
*.recipe.*.tmp

# cuda-new autotune writes exact-key `.recipe` caches into
# configs/tuning/nvidia/** on the tuning machine. They are keyed to one
# machine and one library build and are never committed; the AMD measured
# recipes (version-gated, safe-degrading defaults) are the one exception —
# see configs/tuning/README.md.
configs/tuning/**/*.recipe
!configs/tuning/amd/**/*.recipe

# Local development artifacts (see AGENTS.md)
/devlocal/
crates/.gemm-pilot-link.lock
target-gemm-pilot/
target-p92i/
.claude/

# Local MLX toolchains and runtime state.
.apxinf/

# Platform build presets
#
# One file per validated build target. `just build-py APXINF_PLATFORM=<name>`
# (or `set -a; source configs/platforms/<name>.env; set +a; maturin ...`)
# loads the variables for that target. Values come from the "NVIDIA build
# environment" table in the README and from measured build memory pressure
# on Jetson (see doc/ARCHITECTURE.md).

# Jetson AGX Thor (sm_110, CUDA 13.0)
APXINF_CUDA_ARCH=sm_110
# nvcc parallelism defaults to 2*(cores-1); on Jetson's 14-16 core ARM CPUs
# this OOMs the 64-128 GB LPDDR during release builds.
APXINF_NVCC_PARALLELISM=4
